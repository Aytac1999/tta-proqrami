{
  "manifest_version": 3,
  "name": "TTA Köməkçisi - e-taxes",
  "version": "1.6.0",
  "description": "e-taxes qaimələrindən qaimə tərkibi (Excel), təhvil-təslim aktı və qiymət razılaşdırma protokolu hazırlayır. Səhifənin üstündə üzən pəncərədə açılır, yenidən daxil olmaq tələb olunmur.",
  "action": {
    "default_title": "TTA Köməkçisi",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://new.e-taxes.gov.az/*",
    "https://raw.githubusercontent.com/*"
  ],
  "sandbox": {
    "pages": [
      "sandbox.html"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://new.e-taxes.gov.az/*"
      ],
      "js": [
        "icerik.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "panel.html",
        "sandbox.html"
      ],
      "matches": [
        "https://new.e-taxes.gov.az/*"
      ]
    }
  ]
}