{
  "manifest_version": 3,
  "name": "TTA Köməkçisi - e-taxes",
  "version": "1.5.2",
  "description": "e-taxes qaimələrindən qaimə tərkibi (Excel), təhvil-təslim aktı və qiymət razılaşdırma protokolu hazırlayır. Yenidən daxil olmaq tələb olunmur.",
  "action": {
    "default_title": "TTA Köməkçisi",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "scripting",
    "storage",
    "sidePanel"
  ],
  "host_permissions": [
    "https://new.e-taxes.gov.az/*",
    "https://raw.githubusercontent.com/*"
  ],
  "sandbox": {
    "pages": [
      "sandbox.html"
    ]
  },
  "side_panel": {
    "default_path": "panel.html"
  }
}